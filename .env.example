# Key · 环境变量示例
# 用法：复制本文件为 .env，保留下面某一家的配置并填入你的 API Key。
#
# 四家厂商均提供 OpenAI 兼容端点 —— 切换厂商只需改 LLM_BASE_URL + LLM_MODEL。
# 只需配置「一家」即可，其余用 # 注释掉。

# ── DeepSeek（推荐：性价比高，中文强）──────────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── OpenAI ────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── 通义千问（阿里云 DashScope 兼容模式）──────────────────────
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ── 智谱 GLM ──────────────────────────────────────────────────
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 你的 API Key（必填）
LLM_API_KEY=sk-your-key-here

# 请求超时（毫秒，可选，默认 60000）
LLM_TIMEOUT_MS=60000

# ── ComfyUI（图片生成，可选）───────────────────────────────────
# 本机跑 ComfyUI 时用默认地址即可；换局域网机器 / 服务器只改这里。
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# 默认模型文件名（不填走 provider 兜底；非法值会在提交 /prompt 之前被校验拦下）
# COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
# 单次生成的等待上限（毫秒，可选，默认 120000）
# COMFYUI_TIMEOUT_MS=120000
# 产出图片的落盘目录（可选，默认 .rivet/artifacts/comfy）
# COMFYUI_ARTIFACT_DIR=.rivet/artifacts/comfy
